@model TenderModel
@{
    ViewData["title"] = "İhale Detayı";
}

<h4 class="fw-bold mb-4 py-3"><span class="text-muted fw-light">İhale #@Model.TenderCode</span></h4>
<div class="row">
    <div class="col-xl-4 col-lg-5 col-md-5 order-md-0 order-1">
        <div class="card">
            <div class="card-body">
                <div class="customer-avatar-section">
                    <div class="d-flex align-items-center flex-column">
                        <div class="mb-4">
                            <div class="avatar-initial bg-label-primary rounded p-3">
                                <i class="tf-icons ti ti-user ti-xl"></i>
                            </div>
                        </div>
                        <div class="customer-info mb-5 text-center">
                            <h5 class="mb-2">@Model.PublicAuthorityName</h5>
                            <span>Müşteri No #@Model.PublicAuthorityCode</span>
                        </div>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col d-flex">
                        <div class="avatar me-2">
                            <div class="avatar-initial bg-label-primary rounded">
                                <i class="tf-icons ti ti-gavel ti-lg"></i>
                            </div>
                        </div>
                        <div>
                            <h5 class="mb-0">@Model.TenderCode</h5>
                            <span>İhale No</span>
                        </div>
                    </div>
                    <div class="col d-flex">
                        <div class="avatar me-2">
                            <div class="avatar-initial bg-label-primary rounded">
                                <i class="tf-icons ti ti-archive ti-lg"></i>
                            </div>
                        </div>
                        <div>
                            <h5 class="mb-0">@Model.TenderAmount.ToString("n2") @Model.Currency</h5>
                            <span>İhale Tutarı</span>
                        </div>
                    </div>
                </div>
                <div class="row mb-5">
                    <div class="col d-flex">
                        <div class="avatar me-2">
                            <div class="avatar-initial bg-label-primary rounded">
                                <i class="tf-icons ti ti-calendar ti-lg"></i>
                            </div>
                        </div>
                        <div>
                            <h5 class="mb-0">@Model.TenderStartDate.ToShortDateString()</h5>
                            <span>İhale Başlangıç Tarihi</span>
                        </div>
                    </div>
                    <div class="col d-flex">
                        <div class="avatar me-2">
                            <div class="avatar-initial bg-label-primary rounded">
                                <i class="tf-icons ti ti-calendar ti-lg"></i>
                            </div>
                        </div>
                        <div>
                            <h5 class="mb-0">@Model.TenderEndDate.ToShortDateString()</h5>
                            <span>İhale Bitiş Tarihi</span>
                        </div>
                    </div>
                </div>
                <div class="info-container">
                    <h5 class="border-bottom text-capitalize mb-4 mt-6 pb-4">Detaylar</h5>
                    <ul class="list-unstyled mb-6">
                        <li class="mb-2">
                            <span class="h6 me-1">İhale Adı:</span>
                            <span>@Model.TenderName</span>
                        </li>
                        <li class="mb-2">
                            <span class="h6 me-1">İhale Başlangıç Tarihi:</span>
                            <span>@Model.TenderStartDate</span>
                        </li>
                        <li class="mb-2">
                            <span class="h6 me-1">İhale Bitiş Tarihi:</span>
                            <span>@Model.TenderEndDate</span>
                        </li>
                        <li class="mb-2">
                            <span class="h6 me-1">İhale Türü:</span>
                            <span class="badge bg-label-success">@Model.TenderType</span>
                        </li>
                        <li class="mb-2">
                            <span class="h6 me-1">İhale Metodu:</span>
                            <span>@Model.TenderMethod</span>
                        </li>

                        <li class="mb-2">
                            <span class="h6 me-1">İhale Miktarı:</span>
                            <span>@Model.TenderQuantity</span>
                        </li>
                        <li class="mb-2">
                            <span class="h6 me-1">Sözleşme Tarihi:</span>
                            <span>@(Model.ContractDate.HasValue? Model.ContractDate.Value.ToShortDateString(): "")</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-8 col-lg-7 col-md-7 order-0 order-md-1">
        <div class="nav-align-top">
            <ul class="nav nav-pills flex-column flex-md-row row-gap-2 mb-4 flex-wrap">
                <li class="nav-item">
                    <button type="button" class="nav-link active waves-effect waves-light" role="tab" data-bs-toggle="tab" data-bs-target="#navs-devices" aria-controls="navs-devices" aria-selected="true">
                        <i class="icon-base ti tabler-user icon-sm me-1_5"></i>Cihazlar
                    </button>
                </li>
                <li class="nav-item">
                    <button type="button" class="nav-link waves-effect waves-light" role="tab" data-bs-toggle="tab" data-bs-target="#navs-opex" aria-controls="navs-opex" aria-selected="true">
                        <i class="icon-base ti tabler-user icon-sm me-1_5"></i>Opex
                    </button>
                </li>
                <li class="nav-item">
                    <button type="button" class="nav-link waves-effect waves-light" role="tab" data-bs-toggle="tab" data-bs-target="#navs-capex" aria-controls="navs-capex" aria-selected="true">
                        <i class="icon-base ti tabler-user icon-sm me-1_5"></i>Capex
                    </button>
                </li>
                <li class="nav-item">
                    <button type="button" class="nav-link waves-effect waves-light" role="tab" data-bs-toggle="tab" data-bs-target="#navs-reaktif" aria-controls="navs-reaktif" aria-selected="true">
                        <i class="icon-base ti tabler-user icon-sm me-1_5"></i>Reaktif
                    </button>
                </li>
                <li class="nav-item">
                    <button type="button" class="nav-link waves-effect waves-light" role="tab" data-bs-toggle="tab" data-bs-target="#navs-documents" aria-controls="navs-documents" aria-selected="true">
                        <i class="icon-base ti tabler-user icon-sm me-1_5"></i>Zorunlu Belgeler
                    </button>
                </li>
            </ul>

            <div class="tab-content p-0">
                <div class="tab-pane fade show active" id="navs-devices" role="tabpanel">
                    <div class="table-responsive" style="min-height: 650px;">
                        <table id="Table" class="table-bordered table">
                            <thead>
                                <tr>
                                    <th>Tedarik Türü</th>
                                    <th>Stok Kodu</th>
                                    <th>Miktar</th>
                                    <th>Müşteri Kodu</th>
                                    <th>Müşteri Ünvanı</th>
                                    <th>Kira</th>
                                    <th>Servis</th>
                                    <th>Link</th>
                                    <th>Satınlama</th>
                                    <th>Para Birimi</th>
                                    <th>Kayıt Tarihi</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Devices)
                                {
                                    <tr>
                                        <td>@item.SupplyType</td>
                                        <td>@item.StockCode</td>
                                        <td>@item.Quantity</td>
                                        <td>@item.CustomerCode</td>
                                        <td>@item.CustomerName</td>
                                        <td>@item.RentUnitPrice.ToString("n2")</td>
                                        <td>@item.ServiceUnitPrice.ToString("n2")</td>
                                        <td>@item.LinkUnitPrice.ToString("n2")</td>
                                        <td>@item.PurchasePrice.ToString("n2")</td>
                                        <td>@item.Currency</td>
                                        <td>@item.CreatedAt.ToString()</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                </div>
                <div class="tab-pane fade show" id="navs-opex" role="tabpanel">
                    <div class="table-responsive" style="min-height: 650px;">
                        <table id="Table" class="table-bordered table">
                            <thead>
                                <tr>
                                    <th>Alt Kurum Kodu</th>
                                    <th>Alt Kurum Adı</th>
                                    <th>Stok Kodu</th>
                                    <th>Miktar</th>
                                    <th>Birim</th>
                                    <th>Birim Fiyat</th>
                                    <th>Para Birimi</th>
                                    <th>Kayıt Tarihi</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Opexs)
                                {
                                    <tr>
                                        <td>@item.UnitCode</td>
                                        <td>@item.UnitName</td>
                                        <td>@item.StockCode</td>
                                        <td>@item.Quantity</td>
                                        <td>@item.Unit</td>
                                        <td>@item.UnitPrice</td>
                                        <td>@item.Currency</td>
                                        <td>@item.CreatedAt.ToString()</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="tab-pane fade show" id="navs-capex" role="tabpanel">
                    <div class="table-responsive" style="min-height: 650px;">
                        <table id="Table" class="table-bordered table">
                            <thead>
                                <tr>
                                    <th>Alt Kurum Kodu</th>
                                    <th>Alt Kurum Adı</th>
                                    <th>Demirbaş Kodu</th>
                                    <th>Miktar</th>
                                    <th>Birim</th>
                                    <th>Kayıt Tarihi</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Capexs)
                                {
                                    <tr>
                                        <td>@item.UnitCode</td>
                                        <td>@item.UnitName</td>
                                        <td>@item.AssetCode</td>
                                        <td>@item.Quantity</td>
                                        <td>@item.Unit</td>
                                        <td>@item.CreatedAt.ToString()</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="tab-pane fade show" id="navs-reaktif" role="tabpanel">
                    <div class="table-responsive" style="min-height: 650px;">
                        <table id="Table" class="table-bordered table">
                            <thead>
                                <tr>
                                    <th>Alt Kurum Kodu</th>
                                    <th>Alt Kurum Adı</th>
                                    <th>Stok Kodu</th>
                                    <th>Sut Kodu</th>
                                    <th>Test Adı</th>
                                    <th>Test Sayısı</th>
                                    <th>Sut Puanı</th>
                                    <th>Toplam Sut Puanı</th>
                                    <th>Birim</th>
                                    <th>Birim Fiyatı</th>
                                    <th>Kayıt Tarihi</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Reaktifs)
                                {
                                    <tr>
                                        <td>@item.UnitCode</td>
                                        <td>@item.UnitName</td>
                                        <td>@item.StockCode</td>
                                        <td>@item.SutCode</td>
                                        <td>@item.TestName</td>
                                        <td>@item.TestCount</td>
                                        <td>@item.SutPoint</td>
                                        <td>@item.TotalSutPoint</td>
                                        <td>@item.Currency</td>
                                        <td>@item.UnitPrice</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="tab-pane fade show" id="navs-documents" role="tabpanel">
                    <div class="tab-pane fade show" id="navs-documents" role="tabpanel">
                        <div class="table-responsive" style="min-height: 650px;">
                            <table id="Table" class="table-bordered table align-middle">
                                <thead>
                                    <tr>
                                        <th>Belge</th>
                                        <th class="text-center">Zorunluluk</th>
                                        <th class="text-center">Durum</th>
                                        <th class="text-center">Yüklenme Tarihi</th>
                                        <th class="text-center">İncele</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.Documents != null && Model.Documents.Any())
                                    {
                                        foreach (var item in Model.Documents)
                                        {
                                            <tr>
                                                <td>
                                                    @item.DocumentName
                                                </td>
                                                <td class="text-center">
                                                    <input class="form-check-input" type="checkbox" @(item.IsMandatory ? "checked" : "") title="Zorunlu" readonly>
                                                </td>

                                                <td class="text-center">
                                                    <input class="form-check-input" type="checkbox" @(item.Submitted ? "checked" : "") title="Yüklendi" readonly>
                                                </td>

                                                <td class="text-center">
                                                    @(item.SubmissionDate.HasValue? item.SubmissionDate.Value.ToString("dd.MM.yyyy") : "-")
                                                </td>

                                                <td class="text-center">
                                                    @if (item.TenderRequiredDocumentFileId.HasValue)
                                                    {
                                                        <button class="btn btn-outline-primary btn-sm"
                                                                onclick="openFile(
                                                                                                        '@Convert.ToBase64String(item.FileContent)',
                                                                                                        '@item.FileName',
                                                                                                        '@item.FileType'
                                                                                                    )"
                                                                title="Belge Aç / İndir">
                                                            @if (item.FileType == "application/pdf")
                                                            {
                                                                <i class="tf-icons ti ti-file-text text-danger"></i>
                                                            }
                                                            else
                                                            {
                                                                <i class="tf-icons ti ti-file-text text-primary"></i>
                                                            }
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">-</span>
                                                    }
                                                </td>

                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="3" class="text-muted text-center">
                                                Belge bulunamadı
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                    </div>

                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="pdfModal" tabindex="-1">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Belge Görüntüleme</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-0">
                    <iframe id="pdfViewer"
                            style="width:100%; height:80vh;"
                            frameborder="0"></iframe>
                </div>
            </div>
        </div>
    </div>
</div>


<script>
    function openFile(base64File, fileName, mimeType) {

        if (!base64File) {
            alert("Dosya bulunamadı");
            return;
        }

        if (mimeType === "application/pdf") {
            showPdf(base64File);
        } else {
            downloadFile(base64File, fileName, mimeType);
        }
    }

    function showPdf(base64File) {
        const pdfData = "data:application/pdf;base64," + base64File;
        document.getElementById("pdfViewer").src = pdfData;

        const modal = new bootstrap.Modal(
            document.getElementById("pdfModal")
        );
        modal.show();
    }

    function downloadFile(base64File, fileName, mimeType) {
        const link = document.createElement("a");
        link.href = `data:${mimeType};base64,${base64File}`;
        link.download = fileName;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    }
</script>