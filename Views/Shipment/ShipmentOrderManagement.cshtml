@{
    ViewData["title"] = "Sevkiyat Emri Yönetimi";
}

<h4 class="fw-bold mb-4 py-3">
    <span class="text-muted fw-light">@ViewData["title"]</span>
</h4>

<div class="card mb-4">
    <div class="card-header pb-1">
        <h5 class="mb-0">Filtreler</h5>
    </div>
    <div class="card-body pb-2">
        <div class="row g-3">

            <!-- Başlangıç Tarihi -->
            <div class="col-md-3">
                <label class="form-label">Başlangıç Tarihi</label>
                <input type="date" id="startDate" class="form-control">
            </div>

            <!-- Bitiş Tarihi -->
            <div class="col-md-3">
                <label class="form-label">Bitiş Tarihi</label>
                <input type="date" id="endDate" class="form-control">
            </div>

            <!-- Durum -->
            <div class="col-md-3">
                <label class="form-label">Durum</label>
                <select id="status" class="form-select">
                    <option value="0">Tümü</option>
                    <option value="1">Beklemede</option>
                    <option value="2">Toplamada</option>
                    <option value="5">Hazır</option>
                    <option value="6">Tamamlandı</option>
                </select>
            </div>

            <!-- Tamamlananları Göster -->
            <div class="col-md-3 d-flex align-items-end">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="showCompleted">
                    <label class="form-check-label" for="showCompleted">
                        Tamamlanan Kayıtları Göster
                    </label>
                </div>
            </div>

            <!-- Sıfır Fiyatlıları Renklendir -->
            <div class="col-md-3 d-flex align-items-end">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="highlightZeroPrice">
                    <label class="form-check-label" for="highlightZeroPrice">
                        Sıfır Fiyatlıları Renklendir
                    </label>
                </div>
            </div>
        </div>
        <div class="card-footer text-end">
            <button type="button" class="btn btn-primary" id="btnFilter">Filtrele</button>
            <button type="button" class="btn btn-secondary" id="btnClearFilters">Temizle</button>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-datatable text-nowrap pt-0">
        <div class="table-loading" id="tableLoading" style="display:none;">
            <div class="spinner-border text-light" style="width:3rem; height:3rem;"></div>
            <div class="mt-2 text-white">Yükleniyor...</div>
        </div>
        <table id="Table" class="table-bordered table">
            <thead>
                <tr>
                    <th>Sevk Emri No.</th>
                    <th>Sipariş No</th>
                    <th>Tarih</th>
                    <th>Cari Kodu</th>
                    <th>Cari Adı</th>
                    <th>E-Fatura Carisi</th>
                    <th>Durum</th>
                    <th>Kullanıcı</th>
                    <th>Kapalı</th>
                    <th>Kısmi Teslimat</th>
                    <th>Miktar</th>
                    <th>Toplanan</th>
                    <th>Kalan</th>
                    <th>F/I Edilen</th>
                    <th>F/I Edilemeyen</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<div class="modal fade" id="DocumentsModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-shipment modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title mb-3">Belge Listesi</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0">
                <table id="TableDocument" class="dt-fixedheader table-bordered dataTable dtr-column table" style="border-top: 1px solid #dbdade;">
                    <thead>
                        <tr class="dt-header" role="row">
                            <th>Belge No</th>
                            <th>Belge Tipi</th>
                            <th>Tarih</th>
                            <th>Cari Kodu</th>
                            <th>Cari Adı</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="DocumentViewModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-fullscreen-md-down">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Belge Görüntüle</h5>
                <div class="d-flex gap-2">
                    <button class="btn btn-primary btn-sm" onclick="printDocument()">
                        <i class="ti ti-printer me-1"></i> Yazdır
                    </button>
                    <button class="btn-close" data-bs-dismiss="modal"></button>
                </div>
            </div>
            <div class="modal-body p-0" style="height:80vh">
                <div style="position: relative;">
                    <div id="documentFrameContainer">
                        <iframe id="documentFrame" style="width:100%; height:78vh; border:0;"></iframe>
                    </div>

                    <div id="documentLoading"
                         style="position:absolute; top:50%; left:50%; transform:translate(-50%, -50%); display:none; z-index:9999;">
                        <div class="spinner-border text-primary" style="width:3rem; height:3rem;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="eIrsaliyeModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">E-İrsaliye Bilgileri</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <div class="row g-3">

                    <button type="button" class="btn btn-info" onclick="openTemplatePopup()">Şablon Seç</button>

                    <div class="col-md-6">
                        <label class="form-label">Sevk Tarihi ve Saati</label>
                        <input type="datetime-local" id="sevkTarihi" class="form-control">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Plaka</label>
                        <input type="text" id="plaka" class="form-control">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Taşıyıcı VKN / TCKN</label>
                        <input type="text" id="tasiyiciVkn" class="form-control">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Taşıyıcı Adı</label>
                        <input type="text" id="tasiyiciAdi" class="form-control">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Taşıyıcı İl</label>
                        <input type="text" id="tasiyiciIl" class="form-control">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Taşıyıcı İlçe</label>
                        <input type="text" id="tasiyiciIlce" class="form-control">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Taşıyıcı Ülke</label>
                        <input type="text" id="tasiyiciUlke" class="form-control">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Posta Kodu</label>
                        <input type="text" id="tasiyiciPostaKodu" class="form-control">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Şoför Adı</label>
                        <input type="text" id="soforAdi" class="form-control">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Şoför Soyadı</label>
                        <input type="text" id="soforSoyadi" class="form-control">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Şoför TCKN</label>
                        <input type="text" id="soforTckn" class="form-control">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Dorse Plaka 1</label>
                        <input type="text" id="dorse1" class="form-control">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Dorse Plaka 2</label>
                        <input type="text" id="dorse2" class="form-control">
                    </div>

                </div>

            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                <button class="btn btn-primary" id="btnSendEi">Oluştur</button>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="irsaliyeSablonModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">E-İrsaliye Şablonları</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <table id="sablonTable" class="table-bordered table-hover table">
                    <thead>
                        <tr>
                            <th>Şablon</th>
                            <th>Açıklama</th>
                            <th>Plaka</th>
                            <th>Şoför Adı</th>
                            <th>Şoför VKN</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>

        </div>
    </div>
</div>


@section PageScripts {
    <script>
        const table = $('#Table').DataTable({
            language: {
                paginate: {
                    next: '<i class="icon-base ti ti-chevron-right scaleX-n1-rtl icon-18px"></i>',
                    previous: '<i class="icon-base ti ti-chevron-left scaleX-n1-rtl icon-18px"></i>',
                    first: '<i class="icon-base ti ti-chevrons-left scaleX-n1-rtl icon-18px"></i>',
                    last: '<i class="icon-base ti ti-chevrons-right scaleX-n1-rtl icon-18px"></i>'
                },
                url: 'https://cdn.datatables.net/plug-ins/2.3.2/i18n/tr.json',
            },
            processing: false,
            serverSide: true,
            paging: false,
            searching: false,
            order: [
                [0, 'asc']
            ],
            ajax: {
                url: '/Shipment/ShipmentOrderManagementList',
                type: 'POST',
                contentType: 'application/json',
                data: function(d) {
                    d.Filters = {
                        startDate: $("#startDate").val(),
                        endDate: $("#endDate").val(),
                        status: $("#status").val(),
                        showCompleted: $("#showCompleted").is(":checked"),
                        highlightZeroPrice: $("#highlightZeroPrice").is(":checked")
                    };
                    return JSON.stringify(d);
                },
            },
            deferLoading: 0,
            columns: [
                {
                    data: 'BELGE_NO'
                },
                {
                    data: 'SIPARIS_NO'
                },
                {
                    data: 'TARIH',
                    render: function(data, type) {
                        if (type === "sort" || type === "type") return data;
                        return moment(data).format("DD.MM.YYYY");
                    }
                },
                {
                    data: 'CARI_KODU'
                },
                {
                    data: 'CARI_ADI'
                },
                {
                    data: 'EFATURA_CARISI'
                },
                {
                    data: 'DURUM_ACIKLAMA'
                },
                {
                    data: 'KULLANICI_ADSOYAD'
                },
                {
                    data: 'KAPALI'
                },
                {
                    data: 'KISMI_TESLIMAT'
                },
                {
                    data: 'TOPLAM_MIKTAR'
                },
                {
                    data: 'TOPLAM_TOPLANAN'
                },
                {
                    data: 'TOPLAM_KALAN'
                },
                {
                    data: 'TOPLAM_IRS_EDILEN'
                },
                {
                    data: 'TOPLAM_IRS_EDILMEYEN'
                },
                {
                    data: 'BELGE_NO',
                    render: function (data, type, row) {
                        var html = ``;

                        if (row.TOPLAM_IRS_EDILEN > 0) {
                            html += `
                                <button class="btn btn-sm btn-primary me-2" onclick="showDocuments('${row.BELGE_NO}')">
                                    <i class="ti ti-eye me-1"></i> Belgeler
                                </button>
                            `;
                        }

                        if (row.TOPLAM_IRS_EDILMEYEN > 0) {
                            html += `
                                <button class="btn btn-sm btn-danger" onclick="createDocument('${row.BELGE_NO}')">
                                    <i class="ti ti-plus me-1"></i> İrsaliye Oluştur
                                </button>
                            `;
                        }

                        return html;
                    }
                }
            ],
            displayLength: 10,
            layout: {
                topStart: {
                    rowClass: "card-header d-flex border-top rounded-0 flex-wrap py-0 flex-column flex-md-row align-items-start",
                    features: [{
                        search: {
                            className: "me-5 ms-n4 pe-5 mb-n6 mb-md-0",
                            placeholder: "Ara..",
                            text: "_INPUT_"
                        }
                    }]
                },
                topEnd: {
                    rowClass: "row m-3 my-0 justify-content-between",
                    features: [{
                        pageLength: {
                            menu: [10, 25, 50, 100],
                            text: "_MENU_"
                        },
                        buttons: [{
                                extend: "collection",
                                className: "btn btn-label-secondary dropdown-toggle me-4",
                                text: `<span class="d-flex align-items-center gap-1">
                                            <i class="icon-base ti ti-upload icon-xs"></i>
                                            <span class="d-none d-sm-inline-block">Dışarı Aktar</span>
                                          </span>`,
                                buttons: [{
                                        extend: "print",
                                        className: "dropdown-item",
                                        text: `<span class="d-flex align-items-center"><i class="icon-base ti tabler-printer me-1"></i> Print</span>`,
                                        exportOptions: {
                                            columns: [2, 3, 4]
                                        }
                                    },
                                    {
                                        extend: "csv",
                                        className: "dropdown-item",
                                        text: `<span class="d-flex align-items-center"><i class="icon-base ti tabler-file me-1"></i> Csv</span>`,
                                        exportOptions: {
                                            columns: [2, 3, 4]
                                        }
                                    },
                                    {
                                        extend: "excel",
                                        className: "dropdown-item",
                                        text: `<span class="d-flex align-items-center"><i class="icon-base ti tabler-upload me-1"></i> Excel</span>`,
                                        exportOptions: {
                                            columns: [2, 3, 4]
                                        }
                                    },
                                    {
                                        extend: "pdf",
                                        className: "dropdown-item",
                                        text: `<span class="d-flex align-items-center"><i class="icon-base ti tabler-file-text me-1"></i> Pdf</span>`,
                                        exportOptions: {
                                            columns: [2, 3, 4]
                                        }
                                    },
                                    {
                                        extend: "copy",
                                        className: "dropdown-item",
                                        text: `<i class="icon-base ti tabler-copy me-1"></i> Copy`,
                                        exportOptions: {
                                            columns: [2, 3, 4]
                                        }
                                    }
                                ]
                            },
                            {
                                text: `<i class="icon-base ti ti-plus me-sm-1 icon-16px me-0"></i>
                                            <span class="d-none d-sm-inline-block">Yeni Ekle</span>`,
                                className: "add-new btn btn-primary",
                                action: function() {
                                    window.location.href = "Create";
                                }
                            }
                        ]
                    }]
                },
                bottomStart: {
                    rowClass: "row mx-3 justify-content-between",
                    features: ["info"]
                },
                bottomEnd: "paging"
            },
            scrollX: true,

            initComplete: function() {},
            rowCallback: function(row, data) {

                // Önce eski renklendirmeyi temizle
               $(row).removeClass("table-danger");

               // Checkbox işaretli değilse hiçbir şey yapma
               if (!$("#highlightZeroPrice").is(":checked"))
                   return;

               // Sıfır miktar kontrolü
               if (data.SIFIR_FIYAT_VAR == "E") {
                   $(row).addClass("table-danger");
               }
            }
        });

        $('#Table tbody').on('change', '.group-checkbox', function() {

            const groupName = $(this).data("group");
            const checked = $(this).is(":checked");

            table.rows().every(function() {
                const rowData = this.data();
                if (rowData.CARI_ADI === groupName) {
                    $(this.node()).find('.row-checkbox').prop('checked', checked);
                }
            });
        });

        // AJAX başlamadan önce
        table.on('preXhr.dt', function() {
            $("#tableLoading").show();
        });

        // AJAX bittikten sonra
        table.on('xhr.dt', function() {
            $("#tableLoading").hide();
        });

        table.on('processing.dt', function(e, settings, processing) {
            if (processing) {
                $("#tableLoading").show();
            } else {
                $("#tableLoading").hide();
            }
        });

        // Görsel sınıf düzeltmeleri
        setTimeout(() => {
            const adjustments = [{
                    selector: ".dt-buttons .btn",
                    classToRemove: "btn-secondary"
                },
                {
                    selector: ".dt-buttons.btn-group",
                    classToAdd: "mb-md-0 mb-6"
                },
                {
                    selector: ".dt-search .form-control",
                    classToRemove: "form-control-sm",
                    classToAdd: "ms-0"
                },
                {
                    selector: ".dt-search",
                    classToAdd: "mb-0 mb-md-6"
                },
                {
                    selector: ".dt-length .form-select",
                    classToRemove: "form-select-sm"
                },
                {
                    selector: ".dt-layout-end",
                    classToAdd: "gap-md-2 gap-0 mt-0"
                },
                {
                    selector: ".dt-layout-start",
                    classToAdd: "mt-0"
                },
                {
                    selector: ".dt-layout-table",
                    classToRemove: "row mt-2"
                },
                {
                    selector: ".dt-layout-full",
                    classToRemove: "col-md col-12",
                    classToAdd: "table-responsive"
                }
            ];
            adjustments.forEach(({
                selector,
                classToRemove,
                classToAdd
            }) => {
                document.querySelectorAll(selector).forEach(el => {
                    if (classToRemove) classToRemove.split(" ").forEach(cls => el.classList.remove(cls));
                    if (classToAdd) classToAdd.split(" ").forEach(cls => el.classList.add(cls));
                });
            });
        }, 100);


        function openTemplatePopup() {
            $("#irsaliyeSablonModal").modal("show");

            $.ajax({
                url: "/Shipment/ShipmentTemplateList",
                type: "POST",
                success: function (list) {

                    let html = "";
                    list.forEach(item => {
                        html += `
                            <tr>
                                <td>${item.TEMPLATEID}</td>
                                <td>${item.LICENSEPLATEID ?? ""}</td>
                                <td>${item.CARRIERNAME ?? ""}</td>
                                <td>${item.DPERSON1FIRSTNAME ?? ""}</td>
                                <td>${item.CARRIERCITY ?? ""}</td>
                                <td>${item.CARRIERSUBCITY ?? ""}</td>
                                <td>
                                    <button class="btn btn-sm btn-primary btnSelectTemplate"
                                        data-plaka="${item.LICENSEPLATEID}"
                                        data-vkn="${item.CARRIERVKN}"
                                        data-adi="${item.CARRIERNAME}"
                                        data-il="${item.CARRIERCITY}"
                                        data-ilce="${item.CARRIERSUBCITY}"
                                        data-ulke="${item.CARRIERCOUNTRY}"
                                        data-posta="${item.CARRIERPOSTAL}"
                                        data-soforad="${item.DPERSON1FIRSTNAME}"
                                        data-soforsoyad="${item.DPERSON1FAMILYNAME}"
                                        data-sofortckn="${item.DPERSON1NID}"
                                        data-dorse1="${item.DORSEPLAKA1}"
                                        data-dorse2="${item.DORSEPLAKA2}">
                                        Seç
                                    </button>
                                </td>
                            </tr>
                        `;
                    });

                    $("#sablonTable tbody").html(html);

                    $(document).on("click", ".btnSelectTemplate", function () {

                        $("#plaka").val($(this).data("plaka"));
                        $("#tasiyiciVkn").val($(this).data("vkn"));
                        $("#tasiyiciAdi").val($(this).data("adi"));
                        $("#tasiyiciIl").val($(this).data("il"));
                        $("#tasiyiciIlce").val($(this).data("ilce"));
                        $("#tasiyiciUlke").val($(this).data("ulke"));
                        $("#tasiyiciPostaKodu").val($(this).data("posta"));

                        $("#soforAdi").val($(this).data("soforad"));
                        $("#soforSoyadi").val($(this).data("soforsoyad"));
                        $("#soforTckn").val($(this).data("sofortckn"));

                        $("#dorse1").val($(this).data("dorse1"));
                        $("#dorse2").val($(this).data("dorse2"));

                        // Popup'ı kapat
                        $("#irsaliyeSablonModal").modal("hide");
                    });
                }
            });
        }
        function createDocument(documentNumber) {
            $("#eIrsaliyeModal").attr("data-document-number", documentNumber);

            resetEIrsaliyeForm();

            const now = new Date();
            const year = now.getFullYear();
            const month = String(now.getMonth() + 1).padStart(2, '0');
            const day = String(now.getDate()).padStart(2, '0');
            $("#sevkTarihi").val(`${year}-${month}-${day}T00:00`);

            new bootstrap.Modal(document.getElementById('eIrsaliyeModal')).show();

            $("#btnSendEi").off("click").on("click", function () {

                 const btn = $(this);

                // --- LOADING AÇ ---
                btn.prop("disabled", true);
                const originalText = btn.html();
                btn.html(`<span class="spinner-border spinner-border-sm me-2"></span> Gönderiliyor...`);

                const documentNumber = $("#eIrsaliyeModal").attr("data-document-number");

                const payload = {
                    documentNumber: documentNumber,
                    eWaybillInfo: {
                        SEVKTAR: $("#sevkTarihi").val() || null,
                        PLAKA: $("#plaka").val() || "",
                        TASIYICIVKN: $("#tasiyiciVkn").val() || "",
                        TASIYICIADI: $("#tasiyiciAdi").val() || "",
                        TASIYICIIL: $("#tasiyiciIl").val() || "",
                        TASIYICIILCE: $("#tasiyiciIlce").val() || "",
                        TASIYICIULKE: $("#tasiyiciUlke").val() || "",
                        TASIYICIPOSTAKODU: $("#tasiyiciPostaKodu").val() || "",
                        SOFOR1ADI: $("#soforAdi").val() || "",
                        SOFOR1SOYADI: $("#soforSoyadi").val() || "",
                        SOFOR1TCKN: $("#soforTckn").val() || "",
                        SOFOR1ACIKLAMA: $("#soforAciklama").val() || "",
                        DORSEPLAKA1: $("#dorse1").val() || "",
                        DORSEPLAKA2: $("#dorse2").val() || ""
                    }
                };

                $.ajax({
                    url: "/Shipment/CreateDocument",
                    type: "POST",
                    contentType: "application/json",
                    data: JSON.stringify(payload),
                    success: function (res) {
                        if (res.success) {
                            showToast("E-İrsaliye başarıyla oluşturuldu", "success");
                            $("#eIrsaliyeModal").modal("hide");
                        } else {
                            showToast(res.errorMessage, "danger");
                        }
                    },
                    error: function(xhr) {
                        console.error(xhr);
                        alert("İrsaliye oluşturulurken bir hata oluştu");
                    },
                    complete: function () {
                        // --- LOADING KAPAT ---
                        btn.prop("disabled", false);
                        btn.html(originalText);
                    }
                });

            });
        }

        function resetEIrsaliyeForm() {
            $("#eIrsaliyeModal input").val("");
        }

        $("#btnFilter").on("click", function() {
            table.ajax.reload();
        });

        $("#btnClearFilters").on("click", function() {
            $("#startDate").val("");
            $("#endDate").val("");
            $("#status").val("");
            $("#showCompleted ").prop("checked", false);
            $("#highlightZeroPrice  ").prop("checked", false);

            table.ajax.reload();
        });

        document.addEventListener("DOMContentLoaded", function () {

            const today = new Date();
            const firstDay = new Date(today.getFullYear(), today.getMonth(), 1);

            document.getElementById("startDate").value = formatDateLocal(firstDay);
            document.getElementById("endDate").value = formatDateLocal(today);

            function formatDateLocal(date) {
                const year = date.getFullYear();
                const month = String(date.getMonth() + 1).padStart(2, "0");
                const day = String(date.getDate()).padStart(2, "0");
                return `${year}-${month}-${day}`;
            }
        });

        function showDocuments(shipmentNo){
            if ($.fn.DataTable.isDataTable('#TableDocument')) {
                $('#TableDocument').DataTable().clear().destroy();
            }

            var modal = new bootstrap.Modal(document.getElementById('DocumentsModal'));
            var tableDocument = $("#TableDocument").DataTable({
                        language: {
                                paginate: {
                                    next: '<i class="icon-base ti ti-chevron-right scaleX-n1-rtl icon-18px"></i>',
                                    previous: '<i class="icon-base ti ti-chevron-left scaleX-n1-rtl icon-18px"></i>',
                                    first: '<i class="icon-base ti ti-chevrons-left scaleX-n1-rtl icon-18px"></i>',
                                    last: '<i class="icon-base ti ti-chevrons-right scaleX-n1-rtl icon-18px"></i>'
                                },
                                url: 'https://cdn.datatables.net/plug-ins/2.3.2/i18n/tr.json',
                        },
                        processing: false,
                        orderCellsTop: true,
                        serverSide: false,
                        paging: true,
                        dom: 'tp',
                        searching: true,
                        order: [[0, 'asc']],
                        ajax: {
                            url: '/Shipment/DocumentList?shipmentNo='+shipmentNo,
                            type: 'POST',
                            contentType: 'application/json',
                            dataSrc: '',
                            data: function (d) {
                                return JSON.stringify(d);
                            },
                        },
                        columns: [
                            {   data: 'BELGE_NO' },
                            {   data: 'BELGE_TIPI' },
                            {   data: 'TARIH' },
                            {   data: 'CARI_KODU' },
                            {   data: 'CARI_ADI' },
                            {
                                data: 'BELGE_NO',
                                render: function (data, type, row) {
                                    return `
                                        <a href="#" onclick="viewDocumentPopup('${row.RESMI_BELGE_NO}', '${row.BELGE_TIPI}')" class="btn btn-sm btn-info">
                                            <i class="ti ti-eye me-1"></i> Görüntüle
                                        </a>
                                    `;
                                }
                            }
                        ],
                        displayLength: 10,
                        scrollX: false,
                        select: true,
                        initComplete: function () {

                        }
                    });

                        setTimeout(() => {
                            const adjustments = [
                                { selector: ".dt-buttons .btn", classToRemove: "btn-secondary" },
                                { selector: ".dt-buttons.btn-group", classToAdd: "mb-md-0 mb-6" },
                                { selector: ".dt-search .form-control", classToRemove: "form-control-sm", classToAdd: "ms-0" },
                                { selector: ".dt-search", classToAdd: "mb-0 mb-md-6" },
                                { selector: ".dt-length .form-select", classToRemove: "form-select-sm" },
                                { selector: ".dt-layout-end", classToAdd: "gap-md-2 gap-0 mt-0" },
                                { selector: ".dt-layout-start", classToAdd: "mt-0" },
                                { selector: ".dt-layout-table", classToRemove: "row mt-2" },
                                { selector: ".dt-layout-full", classToRemove: "col-md col-12", classToAdd: "table-responsive" }
                            ];
                            adjustments.forEach(({ selector, classToRemove, classToAdd }) => {
                                document.querySelectorAll(selector).forEach(el => {
                                    if (classToRemove) classToRemove.split(" ").forEach(cls => el.classList.remove(cls));
                                    if (classToAdd) classToAdd.split(" ").forEach(cls => el.classList.add(cls));
                                });
                            });
                        }, 100);
            modal.show();
        }

        function viewDocumentPopup(documentNumber, documentType) {
            // Cache buster
            let tick = new Date().getTime();
            let url = `/Shipment/DocumentView?documentNumber=${documentNumber}&documentType=${documentType}&_=${tick}`;

            // 1) Eski iframe'i tamamen sil
            $("#documentFrame").remove();

            // 2) Yeni iframe oluştur
            $("#documentFrameContainer").html(`
                <iframe id="documentFrame" style="width:100%; height:78vh; border:0;"></iframe>
            `);

            // 3) Loading göster
            $("#documentLoading").show();

            // 4) Yeni URL yükle
            $("#documentFrame").attr("src", url);

            // 5) Yüklendiğinde loading gizle
            $("#documentFrame").on("load", function () {
                $("#documentLoading").hide();
            });

            // 6) Modal aç
            var modal = new bootstrap.Modal(document.getElementById('DocumentViewModal'));
            modal.show();
        }

        function printDocument() {
            const frame = document.getElementById('documentFrame');

            if (frame && frame.contentWindow) {
                frame.contentWindow.focus();
                frame.contentWindow.print();
            }
        }

        function showToast(message, type = "success") {

            const toastEl = document.getElementById("globalToast");
            const toastMessage = document.getElementById("toastMessage");

            toastEl.classList.remove("bg-success", "bg-danger", "bg-warning", "bg-info");

            switch (type) {
                case "success":
                    toastEl.classList.add("bg-success");
                    break;
                case "danger":
                case "error":
                    toastEl.classList.add("bg-danger");
                    break;
                case "warning":
                    toastEl.classList.add("bg-warning");
                    break;
                default:
                    toastEl.classList.add("bg-info");
                    break;
            }

            toastMessage.innerText = message;

            const bsToast = new bootstrap.Toast(toastEl, {
                delay: 3000
            });
            bsToast.show();
        }
    </script>
}

<div class="position-fixed bottom-0 end-0 p-3" style="z-index:1080;">
    <div id="globalToast" class="toast border-0 text-white" role="alert">
        <div class="d-flex">
            <div id="toastMessage" class="toast-body">
                <!-- JS ile doldurulacak -->
            </div>
            <button type="button" class="btn-close btn-close-white m-auto me-2" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

