@model OrderModel

<h4 class="fw-bold mb-3">Sipariş Detayı – @Model.SIPARIS_NO</h4>

<div class="card mb-4">
    <div class="card-header">Sipariş Bilgileri</div>
    <div class="card-body row g-3">

        <div class="col-md-4">
            <label class="form-label">Sipariş No</label>
            <input class="form-control" value="@Model.SIPARIS_NO" readonly />
        </div>

        <div class="col-md-4">
            <label class="form-label">Tarih</label>
            <input class="form-control" value="@Model.TARIH.ToString("dd.MM.yyyy")" readonly />
        </div>

        <div class="col-md-4">
            <label class="form-label">Cari Kodu</label>
            <input class="form-control" value="@Model.CARI_KODU" readonly />
        </div>

        <div class="col-md-12">
            <label class="form-label">Açıklama</label>
            <textarea class="form-control" readonly>@Model.ACIKLAMA</textarea>
        </div>

    </div>
</div>

<div class="card">
    <div class="card-header">Sipariş Satırları</div>
    <div class="card-body p-0">

        <table class="table-bordered m-0 table">
            <thead class="table-light">
                <tr>
                    <th>Sıra</th>
                    <th>Stok Kodu</th>
                    <th>Stok Adı</th>
                    <th>Miktar</th>
                    <th>Kalan</th>
                    <th>Birim Fiyat</th>
                    <th>Tutar</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in Model.Lines)
                {
                    <tr>
                        <td>@l.SIRA</td>
                        <td>@l.STOKKODU</td>
                        <td>@l.STOK_ADI</td>
                        <td>@l.MIKTAR</td>
                        <td class="@(l.KALAN > 0 ? "text-danger fw-bold" : "text-success")">@l.KALAN</td>
                        <td>@l.FIYAT.ToString("N2")</td>
                        <td>@l.TUTAR.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>

    </div>
</div>

<div class="mt-3 text-end">
    <a href="/Shipment/ShipmentOrderManagement" class="btn btn-secondary">Geri</a>
</div>
