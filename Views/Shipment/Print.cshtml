@{
    Layout = null;
}
@model OrderManagementListModel
<!doctype html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Sevk Emri</title>

        <style>
            /* ============ PRINT SETUP ============ */
            @@page {
                size: A4;
                margin: 10mm;
            }

            @@media print {
                body {
                    -webkit-print-color-adjust: exact;
                    print-color-adjust: exact;
                }

                .no-print {
                    display: none !important;
                }
            }

            /* ============ BASE ============ */
            :root {
                --border: #000;
                --text: #000;
                --muted: #333;
                --thin: 1px;
            }

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                font-family: Arial, Helvetica, sans-serif;
                color: var(--text);
                background: #fff;
            }

            /* A4 content area */
            .page {
                width: 190mm; /* A4 width (210) - margins (~10mm*2) */
                margin: 0 auto;
                padding: 0;
            }

            /* ============ HEADER ============ */
            .header {
                display: flex;
                align-items: flex-start;
                justify-content: space-between;
                gap: 10mm;
                margin-bottom: 4mm;
            }

            .header-left {
                display: flex;
                align-items: flex-start;
                gap: 6mm;
                min-width: 55mm;
            }

            .logo {
                width: 42mm;
                height: auto;
                object-fit: contain;
            }

            .header-title {
                flex: 1;
                text-align: center;
                padding-top: 2mm;
            }

                .header-title h1 {
                    margin: 0;
                    font-size: 18pt;
                    letter-spacing: 0.5pt;
                    font-weight: 700;
                }

            .header-right {
                min-width: 35mm;
                display: flex;
                justify-content: flex-end;
            }

        #qr {
            width: 28mm;
            height: 28mm;
            border: 1px solid #000;
            padding: 2mm;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            /* qrcodejs canvas / img */
            #qr canvas,
            #qr img {
                width: 100% !important;
                height: 100% !important;
            }

            /* ============ TOP INFO ============ */
            .info-grid {
                display: grid;
                grid-template-columns: 28mm 4mm 1fr;
                row-gap: 2.2mm;
                column-gap: 2mm;
                font-size: 10.5pt;
                line-height: 1.2;
                margin-top: 2mm;
            }

                .info-grid .label {
                    font-weight: 700;
                }

                .info-grid .sep {
                    text-align: center;
                    font-weight: 700;
                }

                .info-grid .value {
                    color: var(--text);
                }

            .divider {
                border-top: var(--thin) solid var(--border);
                margin: 4mm 0 4mm 0;
            }

            /* ============ TABLES ============ */
            table {
                width: 100%;
                border-collapse: collapse;
                table-layout: fixed;
                font-size: 10.5pt;
            }

            th, td {
                border: var(--thin) solid var(--border);
                padding: 2.2mm 2mm;
                vertical-align: middle;
                word-wrap: break-word;
            }

            th {
                font-weight: 700;
                text-align: center;
            }

            .t-right {
                text-align: right;
            }

            .t-center {
                text-align: center;
            }

            /* Column widths similar to image */
            .col-stok {
                width: 40mm;
            }

            .col-ad {
                width: auto;
            }

            .col-miktar {
                width: 18mm;
            }

            .col-br {
                width: 12mm;
            }

            .col-seri {
                width: 26mm;
            }

            /* ============ FOOTER / NOTES ============ */
            .note {
                margin-top: 4mm;
                font-size: 10pt;
            }

                .note .label {
                    font-weight: 700;
                    margin-bottom: 2mm;
                }

            .footer {
                display: flex;
                align-items: flex-end;
                justify-content: space-between;
                margin-top: 10mm;
                font-size: 10pt;
            }

                .footer .company {
                    font-weight: 700;
                    font-style: italic;
                }

                .footer .pageNo {
                    text-align: center;
                    flex: 1;
                    color: var(--muted);
                }

                .footer .gen {
                    text-align: right;
                    font-style: italic;
                    color: var(--text);
                    min-width: 60mm;
                }

            /* Optional print button */
            .printbar {
                margin: 10px 0;
                display: flex;
                justify-content: flex-end;
            }

            .btn {
                border: 1px solid #333;
                padding: 8px 12px;
                background: #fff;
                cursor: pointer;
                font-size: 14px;
            }
        </style>
</head>

<body>
    <div class="page">
        <!-- HEADER -->
        <div class="header">
            <div class="header-left">
                <!-- LOGO -->
                <img class="logo" src="data:image/png;base64," alt="Logo" />
            </div>

            <div class="header-title">
                <h1>SEVK EMRİ</h1>
            </div>

            <div class="header-right">
                <!-- QR -->
                <div id="qr"></div>
            </div>
        </div>

        <!-- INFO -->
        <div class="info-grid">
            <div class="label">Sevk Emri No</div><div class="sep">:</div><div class="value">@Model.BELGE_NO</div>
            <div class="label">Tarih</div><div class="sep">:</div><div class="value">@Model.TARIH.ToShortDateString()</div>
            <div class="label">Cari Kodu</div><div class="sep">:</div><div class="value">@Model.CARI_KODU</div>
            <div class="label">Cari Adı</div><div class="sep">:</div><div class="value">@Model.CARI_ADI</div>
            <div class="label">İlçe / İl</div><div class="sep">:</div><div class="value">@Model.CARI_IL/@Model.CARI_ILCE</div>
            <div class="label">Adres</div><div class="sep">:</div><div class="value">@Model.CARI_ADRES</div>
            <div class="label">Sipariş No</div><div class="sep">:</div><div class="value">@Model.SIPARIS_NO</div>
        </div>

        <div class="divider"></div>

        <!-- ITEMS TABLE -->
        <table>
            <thead>
                <tr>
                    <th class="col-stok">Stok Kodu</th>
                    <th class="col-ad">Stok Adı</th>
                    <th class="col-miktar">Miktar</th>
                    <th class="col-br">Br</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.SevktraList)
                {
                    <tr>
                        <td>@item.STOK_KODU</td>
                        <td>@item.STOK_ADI</td>
                        <td class="t-right">@item.MIKTAR</td>
                        <td class="t-center">@item.OLCUBR</td>
                    </tr>
                }

            </tbody>
        </table>

        <!-- NOTE -->
        <div class="note">
            <div class="label">Açıklama:</div>
            <div class="value">@Model.ACIK1</div>
        </div>

        <!-- FOOTER -->
        <div class="footer">
            <div class="company">KÜÇÜK GROUP KABLO TİCARET A.Ş</div>
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
    <script>
        const qrText = "@Model.BELGE_NO";
        new QRCode(document.getElementById("qr"), {
          text: qrText,
          width: 120,
          height: 120,
          correctLevel: QRCode.CorrectLevel.M
        });
    </script>
</body>
</html>
