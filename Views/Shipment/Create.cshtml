@model ShipmentModel
@{
    ViewData["title"] = "Sevkiyat Emri";
    Layout = null;
}

@Html.HiddenFor(m => m.TIP)
@Html.HiddenFor(m => m.SUBE_KODU)

<div class="row">
    <div class="col-6">
        <div class="mb-2">
            <label class="form-label" for="BELGENO">Fiş Numarası</label>
            @Html.TextBoxFor(m => m.BELGENO, new { @class = "form-control" })
        </div>
    </div>
    <div class="col-6">
        <div class="mb-2">
            <label class="form-label" for="TARIH">Tarih</label>
            @Html.TextBox("TARIH", Model.TARIH?.ToString("yyyy-MM-dd"), new { @class = "form-control", type = "date" })
        </div>
    </div>
    <div class="col-6">
        <div class="mb-2">
            <label class="form-label" for="SEVKTARIHI">Sevk Tarih</label>
            @Html.TextBox("SEVKTARIHI", Model.SEVKTARIHI?.ToString("yyyy-MM-dd"), new { @class = "form-control", type = "date" })
        </div>
    </div>
    <div class="col-6">
        <div class="mb-2">
            <label class="form-label" for="KOD1">Kod1</label>
            @Html.TextBoxFor(m => m.KOD1, new { @class = "form-control" })
        </div>
    </div>
    <div class="col-6">
        <div class="mb-2">
            <label class="form-label" for="KOD2">Kod2</label>
            @Html.TextBoxFor(m => m.KOD2, new { @class = "form-control" })
        </div>
    </div>
    <div class="col-md-6 d-flex align-items-center">
        <div class="form-check me-4 mt-3">
            @Html.CheckBoxFor(m => m.KAPALI, new { @class = "form-check-input" })
            <label class="form-check-label" for="KAPALI">Kapalı</label>
        </div>
        <div class="form-check mt-3">
            @Html.CheckBoxFor(m => m.KISMI_TESLIMAT, new { @class = "form-check-input" })
            <label class="form-check-label" for="KISMI_TESLIMAT">Kısmi Tesklimat</label>
        </div>
    </div>
</div>

<hr class="my-4">

<h6 class="fw-bold mb-3">Sipariş Kalemleri</h6>

<div class="table-responsive">
    <table class="table-sm table-bordered table align-middle">
        <thead>
            <tr>
                <th class="text-center">Sıra</th>
                <th class="text-center">Sipariş No</th>
                <th class="text-center">Sip. Sıra</th>
                <th>Cari Adı</th>
                <th>Stok Adı</th>
                <th class="text-center">Depo</th>
                <th>Miktar</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.ShipmentLines.Count; i++)
            {
                <tr>
                    <td class="text-center">
                        <input type="hidden" class="form-control" name="ShipmentLines[@i].ID" value="@Model.ShipmentLines[i].ID" />
                        <input type="hidden" class="form-control" name="ShipmentLines[@i].SIRA" value="@Model.ShipmentLines[i].SIRA" />
                        @Model.ShipmentLines[i].SIRA
                    </td>
                    <td class="text-center">
                        <input type="hidden" class="form-control" name="ShipmentLines[@i].SIPNO" value="@Model.ShipmentLines[i].SIPNO" />
                        @Model.ShipmentLines[i].SIPNO
                    </td>
                    <td class="text-center">
                        <input type="hidden" class="form-control" name="ShipmentLines[@i].SIPKONT" value="@Model.ShipmentLines[i].SIPKONT" />
                        @Model.ShipmentLines[i].SIPKONT
                    </td>
                    <td>
                        @Model.ShipmentLines[i].TESCARIADI<br />
                        @Model.ShipmentLines[i].TESCARI
                    </td>
                    <td>
                        @Model.ShipmentLines[i].STOKADI<br />
                        @Model.ShipmentLines[i].STOKKODU
                    </td>
                    <td class="text-center">@Model.ShipmentLines[i].DEPO</td>
                    <td><input type="number" step="1" min="0" max="@Model.ShipmentLines[i].MIKTAR" class="form-control" name="ShipmentLines[@i].MIKTAR" value="@Model.ShipmentLines[i].MIKTAR?.ToString("0.########")" /></td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section VendorScripts {
    <script src="~/js/form-basic-inputs.js"></script>
}