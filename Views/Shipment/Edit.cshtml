@model ShipmentModel
@{
    ViewData["Title"] = "Sevk Emri Düzenleme";
}

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">@ViewData["Title"] (@Model.BELGENO)</h5>

        <a href="/Shipment/OrderManagement" class="btn btn-secondary">
            <i class="ti ti-arrow-left"></i> Geri Dön
        </a>
    </div>

    <div class="card-body">

        <form asp-action="EditShipment" method="post">

            @Html.HiddenFor(m => m.TIP)
            @Html.HiddenFor(m => m.SUBE_KODU)
            @Html.HiddenFor(m => m.BELGENO)

            <div class="row g-4">

                <!-- Fiş Numarası -->
                <div class="col-md-4">
                    <label class="form-label">Fiş No</label>
                    @Html.TextBoxFor(m => m.BELGENO, new { @class = "form-control", @readonly = "readonly" })
                </div>

                <!-- Tarih -->
                <div class="col-md-4">
                    <label class="form-label">Tarih</label>
                    <input type="date" name="TARIH" class="form-control"
                           value="@Model.TARIH?.ToString("yyyy-MM-dd")" />
                </div>

                <!-- Sevk Tarihi -->
                <div class="col-md-4">
                    <label class="form-label">Sevk Tarihi</label>
                    <input type="date" name="SEVKTARIHI" class="form-control"
                           value="@Model.SEVKTARIHI?.ToString("yyyy-MM-dd")" />
                </div>

                <!-- Kodlar -->
                <div class="col-md-4">
                    <label class="form-label">Kod 1</label>
                    @Html.TextBoxFor(m => m.KOD1, new { @class = "form-control" })
                </div>

                <div class="col-md-4">
                    <label class="form-label">Kod 2</label>
                    @Html.TextBoxFor(m => m.KOD2, new { @class = "form-control" })
                </div>

                <!-- Checkbox alanları -->
                <div class="col-md-4">
                    <div class="form-check mt-4">
                        @Html.CheckBoxFor(m => m.KAPALI, new { @class = "form-check-input" })
                        <label class="form-check-label">Kapalı</label>
                    </div>

                    <div class="form-check mt-2">
                        @Html.CheckBoxFor(m => m.KISMI_TESLIMAT, new { @class = "form-check-input" })
                        <label class="form-check-label">Kısmi Teslimat</label>
                    </div>
                </div>

            </div>

            <hr class="my-4" />

            <!-- Satır Listesi -->
            <h5 class="mb-3">Sevk Emri Kalemleri</h5>

            <div class="table-responsive">
                <table class="table-bordered table-striped table">
                    <thead class="table-light">
                        <tr>
                            <th>Sıra</th>
                            <th>Sipariş No</th>
                            <th>Sip. Sıra</th>
                            <th>Cari Adı</th>
                            <th>Stok Adı</th>
                            <th>Depo</th>
                            <th>Miktar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.ShipmentLines.Count; i++)
                        {
                            <tr>
                                <td>
                                    <input type="hidden" name="ShipmentLines[@i].ID" value="@Model.ShipmentLines[i].ID" />
                                    <input type="hidden" name="ShipmentLines[@i].SIRA" value="@Model.ShipmentLines[i].SIRA" />
                                    @Model.ShipmentLines[i].SIRA
                                </td>

                                <td>
                                    <input type="hidden" name="ShipmentLines[@i].SIPNO" value="@Model.ShipmentLines[i].SIPNO" />
                                    <a href="/Shipment/OrderDetails?siparisNo=@Model.ShipmentLines[i].SIPNO">@Model.ShipmentLines[i].SIPNO</a>
                                </td>

                                <td>
                                    <input type="hidden" name="ShipmentLines[@i].SIPKONT" value="@Model.ShipmentLines[i].SIPKONT" />
                                    @Model.ShipmentLines[i].SIPKONT
                                </td>

                                <td>@Model.ShipmentLines[i].TESCARIADI <br /> @Model.ShipmentLines[i].TESCARI</td>

                                <td>@Model.ShipmentLines[i].STOKADI <br /> @Model.ShipmentLines[i].STOKKODU</td>

                                <td>@Model.ShipmentLines[i].DEPO</td>

                                <td>
                                    <input type="number"
                                           name="ShipmentLines[@i].MIKTAR"
                                           class="form-control"
                                           min="0"
                                           step="1"
                                           max="@Model.ShipmentLines[i].MIKTAR"
                                           value="@Model.ShipmentLines[i].MIKTAR?.ToString("0.##")" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-end mt-4">
                <button type="submit" class="btn btn-primary me-2">
                    <i class="ti ti-device-floppy"></i> Kaydet
                </button>

                <a href="/Shipment/OrderManagementList" class="btn btn-secondary">
                    Vazgeç
                </a>
            </div>

        </form>

    </div>
</div>
