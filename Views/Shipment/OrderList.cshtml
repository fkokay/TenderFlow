@{
    ViewData["title"] = "Sevkiyat Emri";
}

<h4 class="fw-bold mb-4 py-3">
    <span class="text-muted fw-light">@ViewData["title"]</span>
</h4>

<div class="card mb-4">
    <div class="card-body row g-3">

        <!-- Cari Hesap -->
        <div class="col-md-3">
            <label class="form-label" for="filterCari">Cari Hesap</label>
            <div class="input-group">
                <input type="text" id="filterCari" class="form-control form-control-sm" placeholder="Cari Kodu">
                <button type="button" class="btn btn-sm btn-outline-secondary" title="Temizle" onclick="TenderFlow.CustomerSelector.clear()"><i class="ti ti-x"></i></button>
                <button type="button" class="btn btn-sm btn-outline-secondary waves-effect" title="Seç" onclick="TenderFlow.CustomerSelector.open()">...</button>
            </div>
        </div>

        <!-- Başlangıç Tarihi -->
        <div class="col-md-2">
            <label class="form-label" for="filterStart">Başlangıç Tarihi</label>
            <div class="input-group">
                <input type="date" id="filterStart" class="form-control form-control-sm">

                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="TenderFlow.DateFilter.clearStart()" title="Temizle">
                    <i class="ti ti-x"></i>
                </button>
            </div>
        </div>

        <!-- Bitiş Tarihi -->
        <div class="col-md-2">
            <label class="form-label" for="filterEnd">Bitiş Tarihi</label>
            <div class="input-group">
                <input type="date" id="filterEnd" class="form-control form-control-sm">

                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="TenderFlow.DateFilter.clearEnd()" title="Temizle">
                    <i class="ti ti-x"></i>
                </button>
            </div>
        </div>

        <!-- Depo -->
        <div class="col-md-2">
            <label class="form-label">Depo</label>
            <select id="filterDepo" class="form-select form-select-sm filter-depo">
                <option value="">Tümü</option>
                @if (ViewBag.Warehouses is List<WarehouseModel> warehouses && warehouses != null)
                {
                    foreach (var item in warehouses)
                    {
                        <option value="@item.DEPO_KODU">@item.DEPO_KODU - @item.DEPO_TANIMI</option>
                    }
                }
            </select>
        </div>

        <!-- Bakiyesi Olanlar -->
        <div class="col-md-2 d-flex align-items-end">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="filterHasBalance">
                <label class="form-check-label" for="filterHasBalance">Bakiyesi Olanlar</label>
            </div>
        </div>

    </div>

    <div class="card-footer text-end">
        <button type="button" class="btn btn-primary" id="btnFilter">Filtrele</button>
        <button type="button" class="btn btn-secondary" id="btnClearFilters">Temizle</button>
    </div>
</div>
<div class="card">
    <div class="card-header shipment-actions">
        <button class="btn btn-primary" onclick="TenderFlow.OrderList.createShipment()">Sevkiyat Oluştur</button>
    </div>
    <div class="card-datatable table-responsive">
        <div class="table-loading" id="tableLoading" style="display:none;">
            <div class="spinner-border text-light" style="width:3rem; height:3rem;"></div>
            <div class="mt-2 text-white">Yükleniyor...</div>
        </div>
        <table id="Table" class="dt-fixedheader table-bordered dataTable dtr-column table">
            <thead>
                <tr>
                    <th></th>
                    <th>Id</th>
                    <th>Sipariş No</th>
                    <th>Sıra</th>
                    <th>Cari Kodu</th>
                    <th>Cari Adı</th>
                    <th>Tarih</th>
                    <th>Teslim Tarihi</th>
                    <th>Stok Kodu</th>
                    <th>Stok Adı</th>
                    <th>Sipariş Miktarı</th>
                    <th>Gönderilen</th>
                    <th>Kalan Miktar</th>
                    <th>Depo Bakiye</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<div class="modal fade" id="shipmentModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-shipment modal-dialog-centered">
        <div class="modal-content">
            <form action="@Url.Action("CreateShipment", "Shipment")" method="post" id="shipmentForm">
                <div class="modal-header">
                    <h5 class="modal-title">Sevkiyat Emri Oluştur</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary" id="btnConfirmShipment">Sevkiyat Emri Oluştur</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="customerSelectModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-shipment modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title mb-3">Cari Rehberi</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0">
                <table id="TableCustomer" class="dt-fixedheader table-bordered dataTable dtr-column table" style="border-top: 1px solid #dbdade;">
                    <thead>
                        <tr class="dt-header" role="row">
                            <th>Cari Kodu</th>
                            <th>Cari Adı</th>
                            <th style="width:80px;">Seç</th>
                        </tr>
                        <tr class="dt-filter-row" role="row">
                            <th data-orderable="false"><input type="text" class="form-control form-control-sm" placeholder="Cari Kodu"></th>
                            <th data-orderable="false"><input type="text" class="form-control form-control-sm" placeholder="Cari Adı"></th>
                            <th></th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

@section PageScripts {
    <script src="~/pages/base.js"></script>
    <script src="~/pages/date-filter.js"></script>
    <script src="~/pages/customer-selector.js"></script>
    <script src="~/pages/order-list.js"></script>
    <script>
        TenderFlow.CustomerSelector.init();
        TenderFlow.OrderList.init();
    </script>
}

@{
    ViewData["NavbarAction"] = @"
        <li class='nav-item ms-2'>
            <button class='btn btn-primary btn-sm'
                    onclick='TenderFlow.OrderList.createShipment()'>
                <i class='ti ti-truck me-1'></i>
                Sevkiyat Oluştur
            </button>
        </li>";
}