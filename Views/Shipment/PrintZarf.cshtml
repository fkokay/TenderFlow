@{
    Layout = null;
}
@model OrderManagementListModel
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <title>Sevk Emri Sayfa</title>

    <style>
        /* ===== PRINT AYARLARI ===== */
        @@page {
            size: A4;
            margin: 10mm;
        }

        @@media print {
            body {
                margin: 0;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
        }

        /* ===== BASE ===== */
        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            color: #000;
        }

        .page {
            width: 210mm;
            height: 297mm;
            position: relative;
        }

        /* ===== ORTA BİLGİ ===== */
        .center-block {
            position: absolute;
            top: 120mm;            /* dikey konum */
            left: 50%;
            transform: translateX(-50%);
            text-align: center;
        }

        .center-block .firma {
            font-size: 11pt;
            font-weight: 700;
            margin-bottom: 3mm;
        }

        .center-block .adres {
            font-size: 10pt;
            font-weight: 600;
        }

        /* ===== SAĞ İL / İLÇE ===== */
        .right-location {
            position: absolute;
            top: 135mm;
            right: 20mm;
            font-size: 10pt;
            font-weight: 700;
        }

        /* ===== ALT ORTA NUMARA ===== */
        .bottom-number {
            position: absolute;
            bottom: 20mm;
            left: 50%;
            transform: translateX(-50%);
            font-size: 10pt;
            font-weight: 700;
            letter-spacing: 1px;
        }
    </style>
</head>

<body>

<div class="page">

    <!-- ORTA -->
    <div class="center-block">
        <div class="firma">
            @Model.CARI_ADI
        </div>
        <div class="adres">
            @Model.CARI_ADRES
        </div>
    </div>

    <!-- SAĞ -->
    <div class="right-location">
        @Model.CARI_IL / @Model.CARI_ILCE
    </div>

    <!-- ALT ORTA -->
    <div class="bottom-number">
        5020038
    </div>

</div>

</body>
</html>
