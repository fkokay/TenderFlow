@model EditUserModel
@{
    ViewData["Title"] = "Kullanıcı Düzenle";
}
<style>
    #roleListBox {
        min-height: 320px;
        font-size: 0.95rem;
    }
</style>



<div class="col-md mb-4 mb-md-0">
    <div class="card">
        <h5 class="card-header">Kullanıcı Düzenle</h5>

        <div class="card-body">

            <!-- TAB HEADERS -->
            <ul class="nav nav-tabs mb-3" role="tablist">
                <li class="nav-item">
                    <button class="nav-link active"
                            data-bs-toggle="tab"
                            data-bs-target="#tab-general"
                            type="button">
                        Genel Bilgiler
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link"
                            data-bs-toggle="tab"
                            data-bs-target="#tab-roles"
                            type="button">
                        Roller
                    </button>
                </li>
            </ul>

            <!-- FORM -->
            <form id="editUserForm"
                  asp-action="Edit"
                  method="post">


                <input type="hidden" asp-for="Id" />

                <div class="tab-content">

                    <!-- TAB 1 : GENEL -->
                    <div class="tab-pane fade show active" id="tab-general">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Adı</label>
                                <input asp-for="FirstName" class="form-control" data-required="true" data-error="Ad alanı zorunludur" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Soyadı</label>
                                <input asp-for="LastName" class="form-control" data-required="true" data-error="Soyadı alanı zorunludur" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Telefon</label>
                                <input asp-for="Phone" class="form-control" data-required="true" data-error="Telefon alanı zorunludur" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Mail</label>
                                <input asp-for="Email" type="email" class="form-control" data-required="true" data-error="Mail alanı zorunludur" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Yeni Şifre</label>
                                <input asp-for="Password" type="password" class="form-control" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Durum</label>
                                <select asp-for="Active" class="form-select">
                                    <option value="true">Aktif</option>
                                    <option value="false">Pasif</option>
                                </select>
                            </div>
                        </div>
                    </div>


                    <!-- TAB 2 : ROLLER -->
                    <div class="tab-pane fade" id="tab-roles">

                        <!-- 🔍 Arama -->
                        <div class="mb-2">
                            <input type="text"
                                   id="roleFilter"
                                   class="form-control"
                                   placeholder="Rol ara..." />
                        </div>

                        <!-- 📋 Rol Listesi -->
                        <div id="roleCheckboxList"
                             style="max-height:320px; overflow:auto; border:1px solid #dee2e6; border-radius:6px; padding:10px;">

                            @foreach (var role in Model.Roles.Where(r => Model.SelectedRoleIds.Contains(r.Id)))
                            {
                                <div class="form-check role-item">
                                    <input class="form-check-input role-checkbox"
                                           type="checkbox"
                                           name="SelectedRoleIds"
                                           value="@role.Id"
                                           checked />
                                    <label class="form-check-label fw-semibold">
                                        @role.Name
                                    </label>
                                </div>
                            }

                            @foreach (var role in Model.Roles.Where(r => !Model.SelectedRoleIds.Contains(r.Id)))
                            {
                                <div class="form-check role-item">
                                    <input class="form-check-input role-checkbox"
                                           type="checkbox"
                                           name="SelectedRoleIds"
                                           value="@role.Id" />
                                    <label class="form-check-label">
                                        @role.Name
                                    </label>
                                </div>
                            }
                        </div>



                        <div id="roleError" class="invalid-feedback d-none mt-2">
                            En az bir rol seçmelisiniz.
                        </div>



                        <div id="selectedRolesContainer"></div>

                    </div>





                </div>

                <!-- FORM FOOTER -->
                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Kaydet
                    </button>
                    <a href="/User/List" class="btn btn-outline-secondary">
                        Vazgeç
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

@section PageScripts {

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
              document.addEventListener("DOMContentLoaded", function() {

            const form = document.getElementById("editUserForm");
            const roleList = document.getElementById("roleCheckboxList");
            const roleError = document.getElementById("roleError");

            if (!form || !roleList) return;

            /* ==========================
               INPUT HATA YÖNETİMİ
            ========================== */
            function clearInputError(input) {
                input.classList.remove("is-invalid");
                const feedback = input.parentElement.querySelector(".invalid-feedback");
                if (feedback) feedback.remove();
            }

            function showInputError(input) {
                clearInputError(input);
                input.classList.add("is-invalid");

                const msg = input.dataset.error || "Bu alan zorunludur";
                const div = document.createElement("div");
                div.className = "invalid-feedback";
                div.innerText = msg;

                input.parentElement.appendChild(div);
            }

            form.querySelectorAll("[data-required='true']").forEach(input => {
                input.addEventListener("input", function() {
                    if (this.value.trim()) {
                        clearInputError(this);
                    }
                });
            });

            /* ==========================
               ROLE HATA YÖNETİMİ
            ========================== */
            function selectedRoleCount() {
                return roleList.querySelectorAll(".role-checkbox:checked").length;
            }

            function showRoleError() {
                roleList.classList.add("border", "border-danger");
                roleError?.classList.remove("d-none");
            }

            function clearRoleError() {
                roleList.classList.remove("border", "border-danger");
                roleError?.classList.add("d-none");
            }

            roleList.addEventListener("change", function(e) {
                if (e.target.classList.contains("role-checkbox")) {
                    if (selectedRoleCount() > 0) {
                        clearRoleError();
                    }
                }
            });

            /* ==========================
               FORM SUBMIT
            ========================== */
            form.addEventListener("submit", function(e) {
                e.preventDefault();

                let firstInvalidInput = null;

                /* ---- INPUT ZORUNLULUK ---- */
                const requiredInputs = form.querySelectorAll("[data-required='true']");
                requiredInputs.forEach(input => {
                    if (!input.value.trim()) {
                        showInputError(input);
                        if (!firstInvalidInput) firstInvalidInput = input;
                    } else {
                        clearInputError(input);
                    }
                });

                if (firstInvalidInput) {
                    const tabPane = firstInvalidInput.closest(".tab-pane");

                    if (tabPane && !tabPane.classList.contains("active")) {
                        const tabBtn = document.querySelector(
                            `[data-bs-target="#${tabPane.id}"]`
                        );
                        tabBtn?.click();
                        tabBtn?.addEventListener("shown.bs.tab", function handler() {
                            firstInvalidInput.focus();
                            tabBtn.removeEventListener("shown.bs.tab", handler);
                        });
                    } else {
                        firstInvalidInput.focus();
                    }
                    return;
                }

                /* ---- ROLE ZORUNLULUK ---- */
                if (selectedRoleCount() === 0) {
                    showRoleError();

                    const roleTabBtn = document.querySelector(
                        `[data-bs-target="#tab-roles"]`
                    );
                    roleTabBtn?.click();

                    roleList.scrollIntoView({
                        behavior: "smooth",
                        block: "center"
                    });
                    return;
                }

                /* ==========================
                   AJAX SUBMIT
                ========================== */
                const formData = new FormData(form);

                fetch(form.action, {
                        method: "POST",
                        body: formData
                    })
                    .then(r => r.json())
                    .then(data => {
                        if (data.success) {
                            Swal.fire({
                                icon: "success",
                                title: "Başarılı",
                                text: data.message,
                                confirmButtonText: "Tamam"
                            }).then(() => {
                                window.location.href = "/User/List";
                            });
                        } else {
                            Swal.fire({
                                icon: "error",
                                title: "Hata",
                                text: data.message,
                                confirmButtonText: "Tamam"
                            });
                        }
                    })
                    .catch(() => {
                        Swal.fire({
                            icon: "error",
                            title: "Hata",
                            text: "Bir hata oluştu",
                            confirmButtonText: "Tamam"
                        });
                    });
            });

        });
    </script>

}





