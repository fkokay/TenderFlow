@model MenuModel
@{
    TempData.Keep();
    string? path = Context.Request.Path;
}

<!-- Menu -->
@* ! Do this simple *@
<aside id="layout-menu" class="layout-menu menu-vertical menu bg-menu-theme">

    @* ! Hide app brand if navbar-full *@
    <div class='app-brand demo @((@ViewData["navbarFull"] != null && Convert.ToBoolean(@ViewData["navbarFull"])) ? "d-xl-none" : "")'>
        <a asp-page="/Index" class="app-brand-link">
            <span class="app-brand-logo demo">
                @await Html.PartialAsync("Partials/_Macros")
            </span>
            <span class="app-brand-text demo menu-text fw-bold">@TempData.Peek("appName")</span>
        </a>

        <a href="javascript:void(0);" class="layout-menu-toggle menu-link text-large ms-auto">
            <i class="ti menu-toggle-icon d-none d-xl-block ti-sm align-middle"></i>
            <i class="ti ti-x d-block d-xl-none ti-sm align-middle"></i>
        </a>
    </div>

    <div class="menu-inner-shadow"></div>

    @* ! Starter Kit menu-items *@
    <ul class="menu-inner py-1">
        <li class='menu-item@((path == "/Home/Index" || path == "/") ? " active" : "")'>
            <a asp-controller="Home" asp-action="Index" class="menu-link">
                <i class="menu-icon tf-icons ti ti-smart-home"></i>
                <div data-i18n="Dashboard">Dashboard</div>
            </a>
        </li>

        @if (User.IsInRole("Administrator"))
        {
        <li class='menu-item@(path == "/Firm/List" ? " active" : "")'>
            <a asp-controller="Firm" asp-action="List" class="menu-link">
                <i class="menu-icon tf-icons ti ti-building"></i>
                <div data-i18n="Firmalar">Firmalar</div>
            </a>
        </li>
        }


        @if (Model.Modules.Any(m => m.Code == "TEMINAT" && m.IsActive))
        {
            if (User.IsInRole("Administrator"))
            {
                <li class='menu-item@(path == "/Guarantee/List" ? " active" : "")'>
                    <a asp-controller="Guarantee" asp-action="List" class="menu-link">
                        <i class="menu-icon tf-icons ti ti-certificate"></i>
                        <div data-i18n="Teminatlar">Teminatlar</div>
                    </a>
                </li>
            }
        }

        @if (Model.Modules.Any(m => m.Code == "İHALE" && m.IsActive))
        {
            if (User.IsInRole("Administrator"))
            {

                <li class='menu-item@(path == "/Tender/List" ? " active" : "")'>
                    <a asp-controller="Tender" asp-action="List" class="menu-link">
                        <i class="menu-icon tf-icons ti ti-gavel"></i>
                        <div data-i18n="İhaleler">İhaleler</div>
                    </a>
                </li>
            }
        }
        @if (Model.Modules.Any(m => m.Code == "DEMİRMBAŞ" && m.IsActive))
        {
            if (User.IsInRole("Administrator"))
            {

                <li class='menu-item@(path == "/Asset/List" ? " active" : "")'>
                    <a asp-controller="Asset" asp-action="List" class="menu-link">
                        <i class="menu-icon tf-icons ti ti-archive"></i>
                        <div data-i18n="Demirbaşlar">Demirbaşlar</div>
                    </a>
                </li>
            }
        }

        @if (Model.Modules.Any(m => m.Code == "SEVKİYAT" && m.IsActive))
        {
            if (User.IsInRole("Administrator") || User.IsInRole("Satış") || User.IsInRole("Sevkiyat"))
            {
                <li class='menu-item@(path.Contains("Shipment") ? " open" : "")'>
                    <a href="javascript:void(0)" class="menu-link menu-toggle">
                        <i class="menu-icon tf-icons ti ti-truck-delivery"></i>
                        <div data-i18n="Sevkiyat">Sevkiyat</div>
                    </a>
                    <ul class="menu-sub">
                        @if (User.IsInRole("Administrator") || User.IsInRole("Satış"))
                        {
                            <li class='menu-item@(path == "/Shipment/OrderList" ? " active" : "")'>
                                <a asp-controller="Shipment" asp-action="OrderList" class="menu-link">
                                    <i class="menu-icon tf-icons ti ti-archive"></i>
                                    <div data-i18n="Sevkiyat Emri">Sevkiyat Emri</div>
                                </a>
                            </li>
                        }
                        <li class='menu-item@(path == "/Shipment/OrderManagement" ? " active" : "")'>
                            <a asp-controller="Shipment" asp-action="OrderManagement" class="menu-link">
                                <i class="menu-icon tf-icons ti ti-archive"></i>
                                <div data-i18n="Sevkiyat Emri Yönetimi">Sevkiyat Emri Yönetimi</div>
                            </a>
                        </li>
                    </ul>
                </li>
            }
        }



        @if (User.IsInRole("Administrator"))
        {
            <li class='menu-item@(path.Contains("Role") || path.Contains("User") || path.Contains("Module") ? " open" : "")'>
                <a href="javascript:void(0)" class="menu-link menu-toggle">
                    <i class="menu-icon tf-icons ti ti-settings"></i>
                    <div data-i18n="Ayarlar">Ayarlar</div>
                </a>
                <ul class="menu-sub">
                    @if (User.IsInRole("Administrator"))
                    {
                        <li class='menu-item@(path == "/Role/List" ? " active" : "")'>
                            <a asp-controller="Role" asp-action="List" class="menu-link">
                                <i class="menu-icon tf-icons ti ti-archive"></i>
                                <div data-i18n="Roller">Roller</div>
                            </a>
                        </li>

                        <li class='menu-item@(path == "/User/List" ? " active" : "")'>
                            <a asp-controller="User" asp-action="List" class="menu-link">
                                <i class="menu-icon tf-icons ti ti-archive"></i>
                                <div data-i18n="Kullanıcılar">Kullanıcılar</div>
                            </a>
                        </li>

                        <li class='menu-item@(path == "/Module/List" ? " active" : "")'>
                            <a asp-controller="Module" asp-action="List" class="menu-link">
                                <i class="menu-icon tf-icons ti ti-puzzle"></i>
                                <div data-i18n="Modüller">Modüller</div>
                            </a>
                        </li>
                    }
                </ul>
            </li>
        }

    </ul>

</aside>
<!-- / Menu -->
