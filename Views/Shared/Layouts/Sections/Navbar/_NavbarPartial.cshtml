@using System.Security.Claims
@{
    var name = User.FindFirst(ClaimTypes.Name)?.Value ?? "";
    var surname = User.FindFirst(ClaimTypes.Surname)?.Value ?? "";
    var initials = (name.FirstOrDefault().ToString() + surname.FirstOrDefault().ToString()).ToUpper();
    var roles = User.Claims.Where(c => c.Type == ClaimTypes.Role).Select(r => r.Value).ToList();
}

@if (ViewData["navbarFull"] != null)
{
    <div class="navbar-brand app-brand demo d-none d-xl-flex me-4 py-0">
        <a asp-page="/Index" class="app-brand-link gap-2">
@*             <span class="app-brand-logo demo">
                @await Html.PartialAsync("Partials/_Macros")
            </span> *@
            <span class="app-brand-text demo menu-text fw-bold">@TempData.Peek("appName")</span>
        </a>

        @* ! Display menu close icon only for horizontal-menu with navbar-full *@
        @if (Convert.ToBoolean(@TempData.Peek("menuHorizontal")).ToString() == "True")
        {
            <a href="javascript:void(0);" class="layout-menu-toggle menu-link text-large d-xl-none ms-auto">
                <i class="ti ti-x ti-sm align-middle"></i>
            </a>
        }
    </div>
}

@* ! Not required for layout-without-menu *@
@if (ViewData["navbarHideToggle"] == null)
{
    <div class='layout-menu-toggle navbar-nav align-items-xl-center me-xl-0 me-3 @((Convert.ToBoolean(@TempData.Peek("menuHorizontal")).ToString() == "True") ? "" : "d-xl-none") @((@ViewData["contentNavbar"] != null && Convert.ToBoolean(@ViewData["contentNavbar"])) ? "" : "d-xl-none")'>
        <a class="nav-item nav-link me-xl-4 px-0" href="javascript:void(0)">
            <i class="ti ti-menu-2 ti-sm"></i>
        </a>
    </div>
}

<div class="navbar-nav-right d-flex align-items-center" id="navbar-collapse">

    <!-- Style Switcher -->
    <div class="nav-item me-xl-0 me-2">
        <a class="nav-link style-switcher-toggle hide-arrow" href="javascript:void(0);">
            <i class='ti ti-md'></i>
        </a>
    </div>
    <!--/ Style Switcher -->
    @if (ViewData["NavbarAction"] != null)
    {
        <div id="navbar-action-wrapper" class="navbar-action-hidden">
            @Html.Raw(ViewData["NavbarAction"])
        </div>
    }
    <ul class="navbar-nav align-items-center ms-auto flex-row">
        <!-- User -->
        <li class="nav-item navbar-dropdown dropdown-user dropdown">
            <a class="nav-link dropdown-toggle hide-arrow" href="javascript:void(0);" data-bs-toggle="dropdown">
                <div class="avatar avatar-online">
                    <span class="avatar-initial rounded-circle bg-primary">@initials</span>
                </div>
            </a>
            <ul class="dropdown-menu dropdown-menu-end">
                <li>
                    <a class="dropdown-item" asp-page="/Index">
                        <div class="d-flex">
                            <div class="me-3 flex-shrink-0">
                                <div class="avatar avatar-online">
                                    <span class="avatar-initial rounded-circle bg-primary">@initials</span>
                                </div>
                            </div>

                            <div class="flex-grow-1">
                                <span class="fw-semibold d-block">@name @surname</span>

                                @foreach (var role in roles)
                                {
                                    <div><small class="text-muted">@role</small></div>
                                }
                            </div>
                        </div>
                    </a>
                </li>
                <li>
                    <div class="dropdown-divider"></div>
                </li>
                <li>
                    <a class="dropdown-item" asp-page="/Index">
                        <i class="ti ti-user-check ti-sm me-2"></i>
                        <span class="align-middle">Profilim</span>
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" asp-page="/Index">
                        <i class="ti ti-settings ti-sm me-2"></i>
                        <span class="align-middle">Ayarlar</span>
                    </a>
                </li>
                <li>
                    <div class="dropdown-divider"></div>
                </li>
                <li>
                    <a class="dropdown-item" href="@Url.Action("Logout", "Identity")">
                        <i class="ti ti-logout ti-sm me-2"></i>
                        <span class="align-middle">Çıkış Yap</span>
                    </a>
                </li>
            </ul>
        </li>
        <!--/ User -->
    </ul>
</div>
