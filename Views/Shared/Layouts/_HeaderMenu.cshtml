<script>
    $(document).ready(function () {
        $(function () {
            setActiveMenuLink();
            changeHelpUrlByLang();
        });

        function setActiveMenuLink() {
            var current_page_URL = window.location.pathname;
            current_page_URL = convertToParentUrl(current_page_URL);

            $("#navWrapper li").each(function () {
                var page_URL = $(this).find('a').attr("href")
                if (page_URL == current_page_URL) {
                    $(this).siblings().removeClass("kt-menu__item--active");
                    $(this).addClass('kt-menu__item--active');

                    if ($(this).parents('.kt-menu__subnav').length != 0) {
                        $('#defaultLi').removeClass("kt-menu__item--active");
                        $(this).parents().eq(2).addClass('kt-menu__item--active');
                    }
                }
            });
        }

        function convertToParentUrl(url) {
            if (url == '/Search/SearchResults' || url == '/Search/Detail')
                url = '/Search';
            if (url == '/Preferences/ViewDetail')
                url = '/Preferences/Views';
            if (url == '/Preferences/AddDelegation')
                url = '/Preferences/Delegation';
            if (url == '/Account/UserWizard')
                url = '/Admin/UserList';
            if (url == '/Admin/AddDataSource')
                url = '/Admin/DataSources';
            if (url == '/Admin/AddCompany' || url == '/Admin/CompanyDetail')
                url = '/Admin/CompanyList';
            if (url == '/Dms/Document/Index/4')
                url = '/DMS2';
            if (url.indexOf('Reports') > -1)
                url = '/Reports/Index';

            return url;
        }

        function changeHelpUrlByLang() {
            var url = "https://netoloji.com/dokumanlar/is-akis-otomasyonu-nedir/";

            if (EFlang.localeCode == "tr") {
                url = "https://netoloji.com/dokumanlar/is-akis-otomasyonu-nedir/";
            }
            else if (EFlang.localeCode == "en") {
                url = "https://netoloji.com/en/work-flow-automation/";
            }
            else if (EFlang.localeCode == "de") {
                url = "https://netoloji.com/de/workflow-automatisierung/";
            }
            else if (EFlang.localeCode == "pt") {
                url = "https://netoloji.com/pt/automacao-de-fluxo-de-trabalho/";
            }
            else if (EFlang.localeCode == "es") {
                url = "https://netoloji.com/es/work-flow-automation/";
            }
            else {
                url = "https://netoloji.com/en/work-flow-automation/";
            }

            $("#helpLinkUrl").prop('href', url);
        }
    });
</script>

